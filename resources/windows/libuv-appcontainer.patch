diff --git a/src/win/pipe.c b/src/win/pipe.c
--- a/src/win/pipe.c
+++ b/src/win/pipe.c
@@ -106,8 +106,41 @@
 }


-static void uv__unique_pipe_name(unsigned long long ptr, char* name, size_t size) {
-  snprintf(name, size, "\\\\?\\pipe\\uv\\%llu-%lu", ptr, GetCurrentProcessId());
+static int uv_is_app_container_;
+static DWORD uv_app_container_error_;
+static uv_once_t uv_is_app_container_guard_ = UV_ONCE_INIT;
+
+
+/* Private runtime: query the current-token pseudo-handle instead of opening
+ * a token handle subject to its DACL. A failed query is not a negative result. */
+static void uv__init__is_app_container(void) {
+  DWORD ac;
+  DWORD len;
+
+  ac = 0;
+  len = sizeof(ac);
+  if (!GetTokenInformation(GetCurrentProcessToken(),
+                           TokenIsAppContainer,
+                           &ac,
+                           len,
+                           &len)) {
+    uv_app_container_error_ = GetLastError();
+    return;
+  }
+  uv_is_app_container_ = ac != 0;
+}
+
+
+static int uv__unique_pipe_name(unsigned long long ptr, char* name, size_t size) {
+  uv_once(&uv_is_app_container_guard_, uv__init__is_app_container);
+  if (uv_app_container_error_ != ERROR_SUCCESS)
+    return uv_app_container_error_;
+
+  /* Upstream AppContainer fix: use its private LOCAL pipe namespace. */
+  snprintf(name, size, "\\\\?\\pipe\\%suv\\%llu-%lu",
+           uv_is_app_container_ ? "LOCAL\\" : "",
+           ptr, GetCurrentProcessId());
+  return 0;
 }


@@ -209,11 +242,14 @@
 static int uv__pipe_server(
     HANDLE* pipeHandle_ptr, DWORD access,
     char* name, size_t nameSize, unsigned long long random) {
-  HANDLE pipeHandle;
+  HANDLE pipeHandle = INVALID_HANDLE_VALUE;
+  unsigned int attempts = 0;
   int err;

   for (;;) {
-    uv__unique_pipe_name(random, name, nameSize);
+    err = uv__unique_pipe_name(random, name, nameSize);
+    if (err)
+      goto error;

     pipeHandle = CreateNamedPipeA(name,
       access | FILE_FLAG_FIRST_PIPE_INSTANCE,
@@ -229,6 +265,12 @@
     if (err != ERROR_PIPE_BUSY && err != ERROR_ACCESS_DENIED) {
       goto error;
     }
+
+    /* Private runtime: access denied can be a sandbox policy denial, not
+     * a name collision. Keep collision retries finite and return the actual
+     * Windows error instead of spinning before child-process timers start. */
+    if (++attempts >= 128)
+      goto error;

     /* Pipe name collision.  Increment the random number and try again. */
     random++;
